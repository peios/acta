load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "update",
    srcs = [
        "config.go",
        "docker.go",
        "github.go",
        "http.go",
        "maintenance.go",
        "postgres.go",
        "release.go",
        "service.go",
    ],
    importpath = "acta/internal/update",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/backup",
        "//internal/localstate",
        "//internal/recovery",
        "@com_github_gofrs_flock//:flock",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "update_test",
    srcs = ["service_test.go"],
    embed = [":update"],
    deps = ["//internal/localstate"],
)
