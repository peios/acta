common --enable_bzlmod
build --jobs=4
build --action_env=PATH=/usr/bin:/bin
build --incompatible_strict_action_env
test --test_output=errors
test --test_env=PATH=/usr/bin:/bin
build:race --@rules_go//go/config:race
test:integration --config=race
test:integration --test_env=ACTA_TEST_DATABASE_URL
test:integration --nocache_test_results
build --define=ACTA_VERSION=0.0.0
build:release --@rules_go//go/config:pure
