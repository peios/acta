load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//build:frontend.bzl", "frontend", "frontend_test")

exports_files([
    "package.json",
    "package-lock.json",
])

# gazelle:exclude build
# gazelle:exclude node_modules
# gazelle:exclude .svelte-kit
# gazelle:ignore
# The generated frontend directory is maintained explicitly for go:embed.

filegroup(
    name = "sources",
    srcs = glob([
        "src/**",
        "static/**",
        "tests/**",
        "*.json",
        "*.js",
        "*.mjs",
        "*.ts",
        ".prettier*",
    ]) + [
        "//build/style:eslint-peios.mjs",
        "//internal/tasks:properties.json",
    ],
)

frontend(
    name = "frontend",
    srcs = [":sources"],
    visibility = ["//visibility:public"],
)

frontend_test(
    name = "typecheck",
    srcs = [":sources"],
    mode = "check",
)

frontend_test(
    name = "format_test",
    srcs = [":sources"],
    mode = "format",
)

frontend_test(
    name = "unit_test",
    srcs = [":sources"],
    mode = "test",
)

go_library(
    name = "web",
    srcs = ["embed.go"],
    embedsrcs = [":frontend"],
    importpath = "acta/web",
    visibility = ["//visibility:public"],
)

go_test(
    name = "web_test",
    srcs = ["embed_test.go"],
    embed = [":web"],
)

frontend_test(
    name = "lint_test",
    srcs = [":sources"],
    mode = "lint",
)
