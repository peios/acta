{
    "name": "acta-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite dev --host 127.0.0.1",
        "build": "vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "node --test tests/*.test.mjs",
        "format": "prettier --config .prettierrc.json --write src tests *.js *.ts *.json *.mjs ../build/style/*.mjs",
        "format:check": "prettier --config .prettierrc.json --check src tests *.js *.ts *.json *.mjs ../build/style/*.mjs",
        "test:task-properties": "node tests/task-properties.browser.mjs",
        "lint": "eslint src tests *.js *.ts *.mjs"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "2.70.3",
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "@types/node": "22.20.1",
        "eslint": "10.12.0",
        "eslint-plugin-svelte": "3.23.1",
        "prettier": "3.9.6",
        "prettier-plugin-svelte": "4.1.1",
        "svelte": "5.57.0",
        "svelte-check": "4.7.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.2.2"
    },
    "dependencies": {
        "@tiptap/core": "^3.31.3",
        "@tiptap/extension-link": "^3.31.3",
        "@tiptap/extension-table": "^3.31.3",
        "@tiptap/extension-task-item": "^3.31.3",
        "@tiptap/extension-task-list": "^3.31.3",
        "@tiptap/markdown": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3"
    },
    "overrides": {
        "@sveltejs/kit": {
            "cookie": "0.7.2"
        }
    }
}
