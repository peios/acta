{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 100,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "semi": true,
    "trailingComma": "all",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-svelte"],
    "overrides": [
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        }
    ]
}
