# Copy to .env (which is gitignored) and fill in. Never commit real secrets.

# Public hostname — must match your DNS A/AAAA record. Caddy gets the cert for it
# and the app uses it as the WebAuthn/passkey relying-party id and origin.
ACTA_DOMAIN=acta.example.com

# Display name shown on the passkey prompt (optional).
ACTA_RP_NAME=Acta

# Image tag to run. Defaults to the latest release; pin to a version (e.g.
# v0.1.1) for reproducible deploys.
# ACTA_VERSION=latest

# Postgres password, shared by the database and the app's connection string.
# Generate a long random value, e.g.  openssl rand -base64 32
POSTGRES_PASSWORD=

# First-run admin account, created on boot if it doesn't already exist. Change
# the password after first login (see "Self-hosting" in the README).
ACTA_BOOTSTRAP_USERNAME=admin
ACTA_BOOTSTRAP_PASSWORD=

# Reverse-proxy networks the app trusts for X-Forwarded-For. Defaults to this
# compose's internal network (Caddy). Add Cloudflare's published ranges here if
# you enable its proxy. Comma-separated CIDRs.
# ACTA_TRUSTED_PROXIES=172.28.0.0/16

# Web Push notifications (optional). Generate a key pair with
#   docker compose -f docker-compose.prod.yml run --rm app acta-server genvapid
# and paste both below to enable the per-device notification toggle; leave them
# blank to keep push off. The private key is a secret — keep it out of logs and
# version control. ACTA_VAPID_SUBJECT is optional and defaults to your origin.
# ACTA_VAPID_PUBLIC_KEY=
# ACTA_VAPID_PRIVATE_KEY=
